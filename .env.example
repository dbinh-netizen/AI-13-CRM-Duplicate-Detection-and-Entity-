# ==============================================================================
# SongNhat CRM Duplicate Detection & Entity Resolution - Environment Variables
# ==============================================================================

# Application Environment (dev / integration / staging / prod)
APP_ENV=integration

# Database Configuration
# Local quick dev (SQLite): sqlite:///./data/songnhat_crm.db
# Docker Compose / Staging / Production (PostgreSQL):
DATABASE_URL=postgresql://crm_user:crm_password_change_me@postgres:5432/songnhat_crm_db

# Target PostgreSQL Configuration
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password_change_me
POSTGRES_DB=songnhat_crm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Security & Authentication (JWT Secret Key & Token Expiry)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Intake, Freshness & Matching Engine Limits (Contract W04 v0.2)
MAX_ROWS_PER_FILE=5000
CANDIDATE_CEILING=200000
SUSPECTED_THRESHOLD=65.0
HIGH_CONFIDENCE_THRESHOLD=85.0
FRESHNESS_THRESHOLD_BUSINESS_DAYS=2
