# ==============================================================================
# SongNhat CRM Duplicate Detection & Entity Resolution - Environment Variables
# ==============================================================================

# Application Environment (dev / staging / prod)
APP_ENV=dev

# Database Configuration
# Default for local developer testing: SQLite
DATABASE_URL=sqlite:///./data/songnhat_crm.db

# Target PostgreSQL Configuration (for Docker Compose / Staging / Production)
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password_change_me
POSTGRES_DB=songnhat_crm_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_URL=postgresql://crm_user:crm_password_change_me@localhost:5432/songnhat_crm_db

# Security & Authentication (JWT Secret Key & Token Expiry)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Matching Engine & Batch Processing Limits
CANDIDATE_CEILING=200000
SUSPECTED_THRESHOLD=65.0
HIGH_CONFIDENCE_THRESHOLD=85.0
